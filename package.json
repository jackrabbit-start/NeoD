{
  "name": "neod",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.logic.json",
    "test": "pnpm run build:test && node --experimental-specifier-resolution=node --test tests/**/*.test.mjs",
    "ai:worktree": "bash scripts/ai/create-worktree.sh",
    "ai:session": "bash scripts/ai/create-worktree.sh",
    "ai:publish": "bash scripts/ai/publish-session.sh",
    "ai:ralph-session": "bash scripts/ai/ralph-session.sh"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
